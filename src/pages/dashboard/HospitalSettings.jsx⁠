import React, { useState } from 'react';
import { useAuth } from '../../context/AuthContext';
import { supabase } from '../../lib/supabaseClient';

export default function HospitalSettings() {
  const { hospital, refreshHospital } = useAuth();

  const [formData, setFormData] = useState({
    name: hospital?.name || '',
    address: hospital?.address || '',
    phone: hospital?.phone || '',
    email: hospital?.email || '',
    logo_url: hospital?.logo_url || '',
    invoice_header: hospital?.invoice_header || 'Official Medical Receipt',
    invoice_footer: hospital?.invoice_footer || 'Thank you for choosing us. Get well soon!',
    default_consultation_fee: hospital?.default_consultation_fee || 5000
  });

  const [saving, setSaving] = useState(false);
  const [msg, setMsg] = useState('');

  const handleSave = async (e) => {
    e.preventDefault();
    setSaving(true);
    setMsg('');

    try {
      const { error } = await supabase
        .from('hospitals')
        .update({
          name: formData.name,
          address: formData.address,
          phone: formData.phone,
          email: formData.email,
          logo_url: formData.logo_url,
          invoice_header: formData.invoice_header,
          invoice_footer: formData.invoice_footer,
          default_consultation_fee: Number(formData.default_consultation_fee)
        })
        .eq('id', hospital?.id);

      if (error) throw error;

      setMsg('Hospital branding and print settings saved successfully!');
      if (refreshHospital) await refreshHospital();
    } catch (err) {
      setMsg(`Error saving settings: ${err.message}`);
    } finally {
      setSaving(false);
    }
  };

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: '20px' }}>
      <div>
        <h1 style={{ fontSize: '22px', fontFamily: 'var(--font-display)' }}>Hospital Settings & Branding</h1>
        <p style={{ color: 'var(--muted)', fontSize: '13px' }}>Customize official receipt headers, logo branding, and default hospital fees</p>
      </div>

      <div className="dash-row dash-row-2">
        {/* EDIT SETTINGS FORM */}
        <div className="dash-panel">
          <div className="dash-panel-head">
            <div className="dash-panel-title">Facility Details & Print Branding</div>
          </div>

          {msg && (
            <div style={{ 
              padding: '10px 14px', 
              borderRadius: '6px', 
              fontSize: '12px', 
              marginBottom: '16px',
              background: msg.includes('Error') ? 'var(--danger-soft)' : 'var(--teal-soft)',
              color: msg.includes('Error') ? 'var(--danger)' : 'var(--teal)' 
            }}>
              {msg}
            </div>
          )}

          <form onSubmit={handleSave}>
            <div className="field">
              <label>Hospital Name *</label>
              <input 
                type="text" 
                required 
                value={formData.name} 
                onChange={e => setFormData({ ...formData, name: e.target.value })} 
              />
            </div>

            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '12px' }}>
              <div className="field">
                <label>Phone Number</label>
                <input 
                  type="text" 
                  placeholder="+234 800 000 0000" 
                  value={formData.phone} 
                  onChange={e => setFormData({ ...formData, phone: e.target.value })} 
                />
              </div>
              <div className="field">
                <label>Contact Email</label>
                <input 
                  type="email" 
                  placeholder="contact@hospital.com" 
                  value={formData.email} 
                  onChange={e => setFormData({ ...formData, email: e.target.value })} 
                />
              </div>
            </div>

            <div className="field">
              <label>Physical Address</label>
              <input 
                type="text" 
                placeholder="12 Hospital Road, Victoria Island, Lagos" 
                value={formData.address} 
                onChange={e => setFormData({ ...formData, address: e.target.value })} 
              />
            </div>

            <div className="field">
              <label>Logo Image URL (Optional)</label>
              <input 
                type="text" 
                placeholder="https://example.com/logo.png" 
                value={formData.logo_url} 
                onChange={e => setFormData({ ...formData, logo_url: e.target.value })} 
              />
            </div>

            <div style={{ marginTop: '14px', marginBottom: '8px', fontSize: '12px', fontWeight: '700', color: 'var(--teal)' }}>
              INVOICE & PRINT CONFIGURATION
            </div>

            <div className="field">
              <label>Default Consultation Fee (₦)</label>
              <input 
                type="number" 
                value={formData.default_consultation_fee} 
                onChange={e => setFormData({ ...formData, default_consultation_fee: e.target.value })} 
              />
            </div>

            <div className="field">
              <label>Custom Invoice Title Header</label>
              <input 
                type="text" 
                value={formData.invoice_header} 
                onChange={e => setFormData({ ...formData, invoice_header: e.target.value })} 
              />
            </div>

            <div className="field">
              <label>Invoice Footer Note</label>
              <textarea 
                rows="2" 
                value={formData.invoice_footer} 
                onChange={e => setFormData({ ...formData, invoice_footer: e.target.value })} 
              />
            </div>

            <button type="submit" className="btn btn-primary" disabled={saving} style={{ marginTop: '8px' }}>
              {saving ? 'Saving...' : 'Save Settings'}
            </button>
          </form>
        </div>

        {/* LIVE INVOICE PREVIEW */}
        <div className="dash-panel">
          <div className="dash-panel-head">
            <div className="dash-panel-title">Live Printable Receipt Preview</div>
          </div>

          <div style={{ 
            background: '#ffffff', 
            color: '#1a1a1a', 
            padding: '24px', 
            borderRadius: '8px', 
            fontFamily: 'sans-serif',
            boxShadow: '0 4px 12px rgba(0,0,0,0.1)'
          }}>
            <div style={{ borderBottom: '2px solid #00b4a0', paddingBottom: '12px', marginBottom: '16px', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <div>
                <h2 style={{ fontSize: '18px', margin: 0, color: '#0f172a' }}>{formData.name || 'HOSPITAL NAME'}</h2>
                <div style={{ fontSize: '11px', color: '#64748b' }}>{formData.address || '123 Hospital Way'}</div>
                <div style={{ fontSize: '11px', color: '#64748b' }}>Phone: {formData.phone || 'N/A'}</div>
              </div>
              {formData.logo_url && (
                <img src={formData.logo_url} alt="Logo" style={{ height: '40px', objectFit: 'contain' }} />
              )}
            </div>

            <div style={{ textTransform: 'uppercase', fontSize: '12px', fontWeight: 'bold', color: '#00b4a0', marginBottom: '12px' }}>
              {formData.invoice_header || 'OFFICIAL MEDICAL RECEIPT'}
            </div>

            <table style={{ width: '100%', fontSize: '12px', borderCollapse: 'collapse', marginBottom: '16px' }}>
              <thead>
                <tr style={{ borderBottom: '1px solid #e2e8f0', textAlign: 'left', color: '#475569' }}>
                  <th style={{ padding: '6px 0' }}>Description</th>
                  <th style={{ padding: '6px 0', textAlign: 'right' }}>Amount</th>
                </tr>
              </thead>
              <tbody>
                <tr style={{ borderBottom: '1px solid #f1f5f9' }}>
                  <td style={{ padding: '8px 0' }}>General Doctor Consultation</td>
                  <td style={{ padding: '8px 0', textAlign: 'right' }}>₦{Number(formData.default_consultation_fee).toLocaleString()}</td>
                </tr>
                <tr style={{ borderBottom: '1px solid #f1f5f9' }}>
                  <td style={{ padding: '8px 0' }}>Laboratory Test: Full Blood Count</td>
                  <td style={{ padding: '8px 0', textAlign: 'right' }}>₦3,500</td>
                </tr>
              </tbody>
            </table>

            <div style={{ borderTop: '2px solid #0f172a', paddingTop: '8px', display: 'flex', justifyContent: 'space-between', fontWeight: 'bold', fontSize: '14px' }}>
              <span>Total Paid:</span>
              <span>₦{(Number(formData.default_consultation_fee) + 3500).toLocaleString()}</span>
            </div>

            <div style={{ marginTop: '20px', textAlign: 'center', fontSize: '11px', color: '#64748b', borderTop: '1px dashed #e2e8f0', paddingTop: '10px' }}>
              {formData.invoice_footer}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
