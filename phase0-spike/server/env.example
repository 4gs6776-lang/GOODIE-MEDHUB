# Copy this file to ".env" and change the values.
DATABASE_URL=postgres://medhub:CHANGE_ME@localhost:5432/medhub
# Long random text. Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
PORT=3000
# Leave empty to run plain HTTP. Fill in after running scripts/make-local-ca.sh
TLS_KEY=
TLS_CERT=
# Optional: the cloud address the server should "ping" to know if internet is up.
CLOUD_URL=
